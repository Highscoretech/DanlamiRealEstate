# Google Sheets — where form submissions are written.
#
# Setup:
#   1. In Google Cloud, create a project and enable the Google Sheets API.
#   2. Create a service account and download its JSON key.
#   3. Create the spreadsheet in the CLIENT'S Google account, with two tabs
#      named exactly "Enquiries" and "Partners".
#   4. Share that spreadsheet with the service account email, as Editor.
#      Skipping this step is the usual cause of a 403 on append.
#   5. Copy the values below into .env.local, and into Vercel's env settings.

GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com

# Paste the whole private_key value from the JSON key, quoted, keeping the \n
# escapes exactly as they appear in the file.
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"

# The long id in the sheet URL:
# https://docs.google.com/spreadsheets/d/THIS_PART/edit
SHEET_ID=


# ---------------------------------------------------------------------------
# Email — confirmation to the person who submitted, notification to the office.
#
# Any SMTP provider works. For a Google Workspace or Gmail account use an App
# Password, not the account password: Google account > Security > 2-Step
# Verification > App passwords.
#
# Until these are set the forms still work — messages are logged server-side
# instead of sent, so nothing breaks and no lead is lost.
# ---------------------------------------------------------------------------

# Hostinger. Port 465 is implicit TLS; 587 also works and lib/mail.ts picks
# the right mode from the port number.
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=admin@danlamirealestate.com
SMTP_PASSWORD=

# What recipients see in the From line. This is an alias of the account above —
# Hostinger allows sending as any address on the same domain.
SMTP_FROM="Dan Lami Real Estate <partners@danlamirealestate.com>"

# Where form notifications are sent. Defaults to the address in content/site.ts.
NOTIFY_EMAIL=admin@danlamirealestate.com


# ---------------------------------------------------------------------------
# The WhatsApp group sales partners are invited into after registering.
# Public on purpose: the browser needs it to render the invitation.
# ---------------------------------------------------------------------------

NEXT_PUBLIC_WHATSAPP_GROUP_URL=https://chat.whatsapp.com/B82k6vjYJdDHP9jgmGvYon?mode=gi_t
