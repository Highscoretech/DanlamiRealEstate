# ---------------------------------------------------------------------------
# Email — Hostinger.
#
# Port 465 is implicit TLS, which is what Hostinger recommends. If a host or
# network blocks it, 587 also works (lib/mail.ts switches mode automatically).
#
# We authenticate as admin@ but send as partners@. Hostinger allows this for
# addresses on the same domain; if it ever starts rejecting the From address,
# set SMTP_USER to partners@danlamirealestate.com instead.
# ---------------------------------------------------------------------------
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=admin@danlamirealestate.com
SMTP_PASSWORD=DanLamiKeys2541?
SMTP_FROM="Dan Lami Real Estate <partners@danlamirealestate.com>"

# Where form notifications are sent.
NOTIFY_EMAIL=admin@danlamirealestate.com
